<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/background">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Suggested Recipes" android:textSize="26sp" android:textStyle="bold" android:padding="20dp" android:background="@color/primary" android:textColor="@android:color/white"/>
    <TextView android:id="@+id/txtMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:text="Recipes you can make right now:"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerRecipes" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:padding="12dp"/>
    <Button android:id="@+id/btnBackPantry" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="16dp" android:text="Back to Pantry"/>
</LinearLayout>
